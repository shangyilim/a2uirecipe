# Environment variables for ADK & Gemini
# ==============================================================================
# Option A: Google AI Studio (Simplest for local testing)
# Obtain an API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option B: Google Cloud Vertex AI
# Uncomment the lines below if using a Google Cloud project with Vertex AI enabled
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_ENTERPRISE=True

# Optional: Default Stage for recipe_agent (1 = text, 2 = raw json, 3 = rendered UI)
RECIPE_STAGE=3
